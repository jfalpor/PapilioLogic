graph TD
    %% Definición de estilos corregidos
    classDef infraestilo fill:#1e1e26,stroke:#4a4e69,color:#f2e9e4,stroke-width:2px;
    classDef relstyle fill:#22223b,stroke:#9a8c98,color:#f2e9e4,stroke-width:2px;
    classDef brainstyle fill:#4a4e69,stroke:#c9ada7,color:#f2e9e4,stroke-width:2px;
    classDef twinstyle fill:#9a8c98,stroke:#f2e9e4,color:#22223b,stroke-width:3px;
    classDef ollamastyle fill:#c9ada7,stroke:#22223b,color:#22223b,stroke-width:2px;

    subgraph PailioLogic_Architecture
        %% Capa de Datos
        A[/"📡 Captura Exógena & Local"/]
        B["🌊 Ingesta: Apache Kafka"]
        
        %% Capa de Estructura
        C[("🕸️ Motor de Relaciones: Neo4j")]
        
        %% Capa de Inteligencia Causal
        D{{"⚙️ Inferencia: Causal ML DoWhy"}}
        E["🦋 Análisis Efecto Mariposa"]
        
        %% Capa de Simulación
        F[["🪞 Gemelo Digital Predictivo"]]
        G["🚨 Detección de Anomalías"]
        
        %% Capa de Interacción
        H("(🦙) OLLAMA: Interfaz Inteligente")

        %% Flujos y Conexiones
        A --> B
        B --> C
        C -.->|Recursividad| C
        C --> D
        D --> E
        E --> F
        F --> G
        H <==>|Consulta Local| F
    end

    %% Aplicación de estilos
    class A,B infraestilo;
    class C relstyle;
    class D,E brainstyle;
    class F,G twinstyle;
    class H ollamastyle;