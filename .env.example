# ==========================================
# PAILIOLOGIC - PLANTILLA DE CONFIGURACION
# ==========================================

# --- GENERAL ---
ENV=development # development, staging, production
PROJECT_NAME=PailioLogic

# --- INGESTA: APACHE KAFKA ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INPUT=maritime_events
KAFKA_GROUP_ID=pailiologic_consumer_group

# --- RELACIONES: NEO4J ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=PONER_AQUI_TU_CONTRASEÑA
NEO4J_DB_NAME=neo4j

# --- INTERFAZ INTELIGENTE: OLLAMA ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3 # o el modelo que prefieras usar localmente
# Este es el "sistema" que le da personalidad a PailioLogic
SYSTEM_PROMPT="Eres el cerebro de PailioLogic. Tu objetivo es analizar la causalidad marítima y el efecto mariposa basándote en los datos del Gemelo Digital."

# --- LOGGING ---
LOG_LEVEL=DEBUG # INFO, WARNING, ERROR